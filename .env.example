# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU (ENVIRONMENT VARIABLES TEMPLATE)
# Dự án: Web thuyết minh tự động đa ngôn ngữ Chùa Linh Ứng
# ==============================================================================

# ========== CẤU HÌNH BẢO MẬT JWT ==========
JWT_SECRET_KEY=change-this-to-a-super-secret-random-key-in-production
JWT_ALGORITHM=HS256
JWT_CUSTOMER_EXPIRE_MINUTES=480
JWT_ADMIN_EXPIRE_MINUTES=60

# ========== CƠ SỞ DỮ LIỆU RELATIONAL (SQLAlchemy) ==========
# Auth & Payment DB (SQLite aiosqlite cho local dev / PostgreSQL asyncpg cho production)
AUTH_DB_URL=sqlite+aiosqlite:///./data/auth_payment.db

# POI & Navigation DB
POI_DB_URL=sqlite+aiosqlite:///./data/poi.db

# ========== BỘ NHỚ ĐỆM REDIS (Upstash Redis Free Tier hoặc Local Redis) ==========
# Format: redis://default:password@host:port hoặc redis://localhost:6379
REDIS_URL=redis://localhost:6379
# DB 0: Auth Cache (shorted_code TTL, rate limit IP, token blacklist)
# DB 1: Chatbot Cache (FAQ cache, rate limit chat per session)

# ========== HÀNG ĐỢI TIN NHẮN RABBITMQ (CloudAMQP hoặc Local RabbitMQ) ==========
# Format: amqp://user:password@host:port/vhost
AMQP_URL=amqp://guest:guest@localhost:5672/

# ========== GOOGLE GEMINI API (Google AI Studio Free Tier) ==========
# Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# ========== VECTOR DATABASE (Qdrant Cloud Free Tier hoặc Local Qdrant) ==========
# Lấy URL và API key tại: https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.region.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=poi_embeddings

# ========== OBJECT STORAGE (Supabase Storage Free Tier) ==========
# Đăng ký tại: https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=public-media

# ========== THIẾT LẬP MÃ VÉ TIỀN MẶT (SHORTED CODE) ==========
SHORTED_CODE_TTL_SECONDS=1800
SHORTED_CODE_LENGTH=10

# ========== GIỚI HẠN TỐC ĐỘ GỌI (RATE LIMITING) ==========
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_IP_WINDOW_SECONDS=3600
RATE_LIMIT_CHAT_MAX_PER_SESSION=30

# ========== ĐỊNH TUYẾN DỊCH VỤ NỘI BỘ (Docker Compose / Microservices) ==========
AUTH_SERVICE_URL=http://auth-service:8001
POI_SERVICE_URL=http://poi-service:8002
CHATBOT_SERVICE_URL=http://chatbot-service:8003
DATA_PIPELINE_SERVICE_URL=http://data-pipeline:8004

# ========== FRONTEND APPS URL (Dùng khi sinh mã QR vé và điều hướng) ==========
# VITE_CUSTOMER_APP_URL=https://linh-ung-customer.vercel.app
# VITE_ADMIN_DASHBOARD_URL=https://linh-ung-admin.vercel.app
POI_GRPC_TARGET=poi-service:50051
CHATBOT_GRPC_TARGET=chatbot-service:50052
